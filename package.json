{
  "name": "coverlens",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "setup:gitflow": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-git-flow.ps1",
    "lint": "expo lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:privacy": "node ./scripts/build-privacy-html.mjs",
    "probe:covers": "node ./scripts/probe-cover-apis.mjs",
    "probe:covers:steam": "env PROBE_SKIP_SCREENSCRAPER=1 node ./scripts/probe-cover-apis.mjs",
    "ensure-assets": "node ./scripts/ensure-placeholder-assets.mjs",
    "verify:assets": "node ./scripts/verify-and-fix-app-assets.mjs",
    "check:android": "node ./scripts/verify-and-fix-app-assets.mjs && npx expo-doctor && npx --yes -p typescript@~5.9.2 tsc --noEmit -p tsconfig.app.json && npx --yes -p vitest@^4.1.2 vitest run --config vitest.config.cli.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/orbitron": "^0.4.2",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@infinitered/react-native-mlkit-text-recognition": "^5.0.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "babel-plugin-module-resolver": "^5.0.2",
    "expo": "^57.0.21",
    "expo-build-properties": "^57.0.21",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-media-library": "~57.0.4",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eas-cli": "^18.13.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.2"
  },
  "private": true
}
